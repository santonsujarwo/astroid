---
const title = 'Astroid — Static Site Publisher';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Manage, edit and publish multiple static websites from one workspace." />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style is:global>
      :root{font-family:'DM Sans',sans-serif;color:#202522;background:#f6f7f5;font-synthesis:none}
      *{box-sizing:border-box}body{margin:0}button,input,textarea{font:inherit}button{cursor:pointer}
      .shell{min-height:100vh;display:grid;grid-template-columns:248px 1fr}.sidebar{background:#fff;border-right:1px solid #e8ebe7;padding:26px 18px;display:flex;flex-direction:column}
      .brand{display:flex;align-items:center;gap:11px;padding:0 10px 35px;font:800 20px Manrope,sans-serif;letter-spacing:-.8px}.brand-mark{width:31px;height:31px;border-radius:10px;background:#1d342b;color:#c5f36b;display:grid;place-items:center;font-size:18px}
      .workspace{margin:0 6px 28px;padding:12px;background:#f7f8f6;border:1px solid #edf0eb;border-radius:12px}.workspace small,.muted{color:#8b938d;font-size:11px}.workspace strong{display:block;font-size:13px;margin-top:4px}
      .nav-label{font-size:10px;text-transform:uppercase;letter-spacing:1.3px;color:#a1a8a2;padding:0 12px;margin:16px 0 8px;font-weight:700}.nav{display:flex;align-items:center;gap:12px;padding:11px 12px;border-radius:9px;color:#707a72;font-size:13px;margin:2px 0;border:0;background:transparent;text-align:left;width:100%}.nav.active,.nav:hover{background:#edf3e9;color:#243c2d;font-weight:700}.nav .ico{width:18px;text-align:center;font-size:15px}.side-bottom{margin-top:auto;border-top:1px solid #edf0eb;padding:18px 8px 0;font-size:11px;color:#929a93;line-height:1.6}
      main{min-width:0}.topbar{height:72px;border-bottom:1px solid #e8ebe7;background:#fff;display:flex;align-items:center;justify-content:space-between;padding:0 36px}.crumb{font-size:12px;color:#8a938b}.crumb b{color:#29352d}.top-actions{display:flex;align-items:center;gap:12px}.avatar{width:32px;height:32px;border-radius:50%;background:#e8ede3;color:#344c38;display:grid;place-items:center;font-size:11px;font-weight:700}.status{font-size:11px;color:#6d776e;background:#f3f5f1;padding:7px 10px;border-radius:20px}
      .content{max-width:1440px;margin:auto;padding:34px 36px 60px}.page-head{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:27px}.eyebrow{font-size:10px;text-transform:uppercase;letter-spacing:1.5px;color:#8c978d;font-weight:700}.page-head h1{font:800 28px Manrope,sans-serif;letter-spacing:-1.1px;margin:7px 0 5px}.page-head p{font-size:13px;color:#879087;margin:0}.btn{border:0;border-radius:8px;padding:11px 15px;font-size:12px;font-weight:700;display:inline-flex;align-items:center;gap:8px}.btn-dark{background:#20372c;color:white}.btn-dark:hover{background:#304c3b}.btn-light{background:#fff;border:1px solid #e3e8e1;color:#435046}.btn-lime{background:#d5f58b;color:#243622}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:26px}.stat{background:#fff;border:1px solid #e9ede8;border-radius:12px;padding:17px 18px}.stat-top{display:flex;justify-content:space-between;color:#8b958c;font-size:11px}.stat strong{display:block;font:800 25px Manrope,sans-serif;margin:10px 0 3px}.stat em{font-style:normal;color:#8c978d;font-size:10px}
      .section-head{display:flex;align-items:center;justify-content:space-between;margin:26px 0 13px}.section-head h2{font:700 15px Manrope,sans-serif;margin:0}.section-head span{font-size:11px;color:#8d968e}.site-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.site-card{background:#fff;border:1px solid #e8ece7;border-radius:13px;overflow:hidden;transition:.2s;cursor:pointer}.site-card:hover{transform:translateY(-2px);box-shadow:0 10px 30px #1b30200d}.site-cover{height:112px;padding:16px;display:flex;align-items:flex-end;justify-content:space-between;background:linear-gradient(135deg,#dfe9db,#b9cdb7);position:relative;overflow:hidden}.site-cover:after{content:'';position:absolute;width:150px;height:150px;border:1px solid #ffffff88;border-radius:50%;right:-25px;top:-65px;box-shadow:0 0 0 18px #ffffff18,0 0 0 38px #ffffff18}.site-cover.blue{background:linear-gradient(135deg,#d9e5ed,#a9c3d2)}.site-cover.rose{background:linear-gradient(135deg,#f1e3df,#d8b8ad)}.cover-label{font:800 18px Manrope,sans-serif;color:#253c2e;z-index:1}.cover-type{font-size:9px;letter-spacing:1px;text-transform:uppercase;color:#526653;z-index:1}.site-body{padding:15px 16px}.site-title{font:700 14px Manrope,sans-serif;margin:0 0 5px}.site-url{font-size:11px;color:#8a938b}.site-meta{display:flex;align-items:center;justify-content:space-between;border-top:1px solid #eff1ee;margin-top:14px;padding-top:12px;font-size:10px;color:#879087}.dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:#77b96d;margin-right:5px}.site-actions{display:flex;gap:5px}.site-actions button{border:0;background:#f3f5f1;border-radius:6px;padding:5px 8px;color:#667267;font-size:10px}
      .lower-grid{display:grid;grid-template-columns:1.35fr 1fr;gap:15px;margin-top:25px}.panel{background:#fff;border:1px solid #e8ece7;border-radius:12px;padding:18px}.panel h3{font:700 13px Manrope,sans-serif;margin:0 0 16px}.activity{display:flex;gap:12px;align-items:flex-start;padding:11px 0;border-top:1px solid #f0f2ef}.activity:first-of-type{border:0}.activity-icon{width:28px;height:28px;border-radius:8px;background:#f0f4ed;display:grid;place-items:center;font-size:12px}.activity strong{font-size:11px;display:block;font-weight:600}.activity small{font-size:10px;color:#929a93}.quick{display:grid;grid-template-columns:1fr 1fr;gap:9px}.quick button{border:1px solid #edf0eb;background:#fbfcfa;text-align:left;padding:13px;border-radius:9px;color:#334237}.quick b{display:block;font-size:11px;margin:7px 0 3px}.quick small{font-size:10px;color:#909991}
      .editor-layout{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:16px}.editor-main,.editor-side{background:white;border:1px solid #e8ece7;border-radius:12px;padding:20px}.editor-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}.editor-top h2{font:700 15px Manrope;margin:0}.field{margin:14px 0}.field label{display:block;font-size:11px;font-weight:700;color:#667168;margin-bottom:7px}.field input,.field textarea{width:100%;border:1px solid #e4e9e2;border-radius:8px;padding:11px;font-size:12px;outline:none;color:#26332a}.field textarea{min-height:78px;resize:vertical}.field input:focus,.field textarea:focus{border-color:#9ebc8d}.section-row{border:1px solid #edf0eb;border-radius:9px;padding:13px;margin:10px 0;display:flex;justify-content:space-between;align-items:center}.section-row strong{font-size:12px}.section-row small{display:block;font-size:10px;color:#929a93;margin-top:4px}.section-row button{border:0;background:#f2f4f0;border-radius:6px;padding:6px 8px;font-size:10px;color:#69756b}.editor-side h3{font:700 12px Manrope;margin:0 0 14px}.hint{background:#f5f8f1;border-radius:9px;padding:12px;font-size:10px;color:#748071;line-height:1.6;margin-top:12px}.hidden{display:none!important}
      .modal-backdrop{position:fixed;inset:0;background:#14251db0;display:grid;place-items:center;padding:20px;z-index:5}.modal{width:min(440px,100%);background:#fff;border-radius:15px;padding:24px;box-shadow:0 20px 80px #0003}.modal h2{font:800 20px Manrope;margin:0 0 5px}.modal p{font-size:12px;color:#879087;margin:0 0 18px}.modal-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:20px}.toast{position:fixed;bottom:24px;right:24px;background:#20372c;color:#fff;padding:12px 16px;border-radius:9px;font-size:12px;box-shadow:0 8px 30px #0002;z-index:8}
      @media(max-width:1000px){.shell{grid-template-columns:210px 1fr}.site-grid{grid-template-columns:repeat(2,1fr)}.stats{grid-template-columns:repeat(2,1fr)}.content{padding:28px 22px}.topbar{padding:0 22px}}
      @media(max-width:700px){.shell{display:block}.sidebar{display:none}.topbar{height:60px;padding:0 16px}.content{padding:23px 15px 40px}.page-head{align-items:flex-start;gap:14px;flex-direction:column}.page-head h1{font-size:24px}.stats{gap:9px}.stat{padding:13px}.stat strong{font-size:21px}.site-grid{grid-template-columns:1fr}.lower-grid,.editor-layout{grid-template-columns:1fr}.editor-side{order:-1}.status{display:none}.page-head>.btn{align-self:stretch;justify-content:center}}
    </style>
  </head>
  <body>
    <div class="shell">
      <aside class="sidebar">
        <div class="brand"><span class="brand-mark">A</span> astroid</div>
        <div class="workspace"><small>WORKSPACE</small><strong>Personal workspace　⌄</strong></div>
        <div class="nav-label">Workspace</div>
        <button class="nav active" data-view="dashboard"><span class="ico">◫</span> Overview</button>
        <button class="nav" data-view="sites"><span class="ico">▤</span> Websites <span style="margin-left:auto;color:#9aa39a">3</span></button>
        <button class="nav" data-view="templates"><span class="ico">▦</span> Templates</button>
        <div class="nav-label">Manage</div>
        <button class="nav" data-view="activity"><span class="ico">◷</span> Activity log</button>
        <button class="nav" data-view="settings"><span class="ico">⚙</span> Settings</button>
        <div class="side-bottom">ASTROID WORKSPACE<br/>Prototype v0.1.0<br/><span style="color:#b1b8b1">Static Site Publisher</span></div>
      </aside>
      <main>
        <header class="topbar"><div class="crumb">Workspace <span style="padding:0 7px;color:#c3c9c2">/</span> <b id="crumb">Overview</b></div><div class="top-actions"><span class="status">● All changes saved locally</span><div class="avatar">SS</div></div></header>
        <div class="content">
          <section id="dashboard-view">
            <div class="page-head"><div><div class="eyebrow">YOUR WORKSPACE</div><h1>Good morning, Santon 👋</h1><p>Manage your websites and keep every project moving.</p></div><button class="btn btn-dark" id="new-site">＋ Create website</button></div>
            <div class="stats">
              <div class="stat"><div class="stat-top"><span>Total websites</span><span>↗</span></div><strong id="stat-sites">3</strong><em>Across your workspace</em></div>
              <div class="stat"><div class="stat-top"><span>Published</span><span>●</span></div><strong id="stat-published">2</strong><em>Live and accessible</em></div>
              <div class="stat"><div class="stat-top"><span>Draft changes</span><span>✎</span></div><strong id="stat-drafts">1</strong><em>Waiting to be published</em></div>
              <div class="stat"><div class="stat-top"><span>Templates</span><span>▦</span></div><strong>01</strong><em>Available in this prototype</em></div>
            </div>
            <div class="section-head"><h2>Your websites</h2><span id="site-count">3 projects</span></div>
            <div class="site-grid" id="site-grid"></div>
            <div class="lower-grid">
              <div class="panel"><h3>Recent activity</h3><div class="activity"><div class="activity-icon">✎</div><div><strong>Homepage content updated</strong><small>Rheazalea · Just now</small></div></div><div class="activity"><div class="activity-icon">↗</div><div><strong>Website published successfully</strong><small>Essa Jaya · Yesterday</small></div></div><div class="activity"><div class="activity-icon">＋</div><div><strong>New website workspace created</strong><small>Ello Orthodontics · 3 days ago</small></div></div></div>
              <div class="panel"><h3>Quick actions</h3><div class="quick"><button id="quick-create"><span>＋</span><b>New website</b><small>Start a project</small></button><button id="quick-edit"><span>✎</span><b>Edit content</b><small>Open page editor</small></button><button id="quick-template"><span>▦</span><b>Browse templates</b><small>Explore layouts</small></button><button id="quick-publish"><span>↗</span><b>Publish changes</b><small>Deploy a website</small></button></div></div>
            </div>
          </section>
          <section id="sites-view" class="hidden">
            <div class="page-head"><div><div class="eyebrow">PROJECTS</div><h1>Websites</h1><p>All your independent static websites in one place.</p></div><button class="btn btn-dark" id="new-site-2">＋ Create website</button></div><div class="site-grid" id="site-grid-all"></div>
          </section>
          <section id="editor-view" class="hidden">
            <div class="page-head"><div><div class="eyebrow">WEBSITE EDITOR</div><h1 id="editor-title">Edit website</h1><p>Build your page from reusable sections.</p></div><div style="display:flex;gap:8px"><button class="btn btn-light" id="preview-btn">◉ Preview</button><button class="btn btn-dark" id="save-btn">Save changes</button></div></div>
            <div class="editor-layout"><div class="editor-main"><div class="editor-top"><h2>Homepage content</h2><span class="muted">Draft · Autosave off</span></div><div class="field"><label>Website name</label><input id="edit-name" /></div><div class="field"><label>Hero heading</label><input id="edit-heading" /></div><div class="field"><label>Hero description</label><textarea id="edit-description"></textarea></div><div class="section-head"><h2>Page sections</h2><button class="btn btn-light" id="add-section">＋ Add section</button></div><div id="sections-list"></div><div id="section-editor" class="panel hidden" style="margin-top:16px"><div class="editor-top"><h2 id="section-editor-title">Edit section</h2><button class="btn btn-light" id="close-section-editor">Close</button></div><div class="field"><label>Section title / label</label><input id="section-label" /></div><div class="field"><label>Eyebrow text</label><input id="section-eyebrow" placeholder="Optional small heading" /></div><div class="field"><label>Main heading</label><input id="section-heading" /></div><div class="field"><label>Body content</label><textarea id="section-body"></textarea></div><div class="field"><label>Image URL</label><input id="section-image" placeholder="https://example.com/image.jpg" /></div><div class="field"><label>Button label</label><input id="section-button" placeholder="Learn more" /></div><div class="field"><label>Button URL</label><input id="section-link" placeholder="/contact" /></div><div class="field"><label>Layout</label><select id="section-layout"><option value="standard">Standard</option><option value="split">Image + text split</option><option value="centered">Centered</option><option value="cards">Card grid</option></select></div><button class="btn btn-dark" id="save-section">Save section</button></div></div><aside class="editor-side"><h3>Website settings</h3><div class="field"><label>Website URL</label><input id="edit-url" /></div><div class="field"><label>Template</label><input value="Business Starter · v1.0.0" disabled /></div><div class="field"><label>GitHub repository</label><input value="Not connected" disabled /></div><div class="hint"><b>Prototype mode</b><br/>Your edits are saved in this browser for evaluation. GitHub connection and real static-site publishing are planned for the next implementation stage.</div><button class="btn btn-lime" style="width:100%;justify-content:center;margin-top:15px" id="publish-btn">↗ Publish website</button></aside></div>
          </section>
          <section id="templates-view" class="hidden"><div class="page-head"><div><div class="eyebrow">DESIGN SYSTEM</div><h1>Templates</h1><p>Code-based templates registered into your workspace.</p></div></div><div class="site-grid" id="template-grid"><article class="site-card template-card" data-template="business"><div class="site-cover"><span class="cover-label">Business</span><span class="cover-type">Starter template</span></div><div class="site-body"><h3 class="site-title">Business Starter</h3><div class="site-url">Clean, flexible foundation for service businesses.</div><div class="site-meta"><span>v1.0.0 · 8 sections</span><span class="dot"></span>Available</div><button class="btn btn-light" style="margin-top:12px;width:100%;justify-content:center" data-template-use="business">Use template</button></div></article><article class="site-card" id="register-template" style="border-style:dashed;display:grid;place-items:center;min-height:260px;color:#9aa39a;cursor:pointer"><div style="text-align:center"><div style="font-size:25px">＋</div><b style="font-size:12px">Register a template</b><p style="font-size:10px">Add a code-based template package</p></div></article></div><div class="panel hidden" id="template-detail" style="margin-top:18px;max-width:650px"><h3 id="template-detail-title">Template details</h3><p class="muted" id="template-detail-copy"></p><button class="btn btn-dark" id="template-detail-use">Use this template</button></div></section>
          <section id="activity-view" class="hidden"><div class="page-head"><div><div class="eyebrow">WORKSPACE HISTORY</div><h1>Activity log</h1><p>A timeline of changes across your websites.</p></div></div><div class="panel"><div class="activity"><div class="activity-icon">✎</div><div><strong>Homepage content updated</strong><small>Rheazalea · Just now</small></div></div><div class="activity"><div class="activity-icon">↗</div><div><strong>Website published successfully</strong><small>Essa Jaya · Yesterday</small></div></div><div class="activity"><div class="activity-icon">＋</div><div><strong>New website workspace created</strong><small>Ello Orthodontics · 3 days ago</small></div></div></div></section>
          <section id="settings-view" class="hidden"><div class="page-head"><div><div class="eyebrow">PREFERENCES</div><h1>Settings</h1><p>Workspace configuration and integrations.</p></div></div><div class="panel" style="max-width:650px"><h3>Workspace details</h3><div class="field"><label>Workspace name</label><input value="Personal workspace" /></div><div class="field"><label>Owner</label><input value="Santon Sujarwo" /></div><h3 style="margin-top:25px">Integrations</h3><div class="section-row"><div><strong>GitHub</strong><small>Connect a GitHub account to sync website source code.</small></div><button class="btn btn-light" id="github-connect">Connect</button></div><div class="section-row"><div><strong>Deployment provider</strong><small>GitHub Actions · Cloudflare Pages · Netlify</small></div><span class="muted">Coming next</span></div></div></section>
        </div>
      </main>
    </div>
    <div id="modal-root"></div><div id="toast-root"></div>
    <script>
      const starter = [
        {id:'rhea',name:'Rheazalea',url:'rheazalea.com',kind:'Fashion & tailoring',color:'',heading:'Made with care, tailored for you.',description:'Beautiful tailoring for the moments and milestones that matter.',status:'Draft',sections:[{type:'hero',label:'Hero',eyebrow:'WELCOME',heading:'Made with care, tailored for you.',body:'Beautiful tailoring for the moments and milestones that matter.',image:'',button:'Explore services',link:'/services',layout:'split'},{type:'about',label:'About us',eyebrow:'OUR STORY',heading:'Crafted around you',body:'Personalised tailoring with care and attention to detail.',image:'',button:'Learn more',link:'/about',layout:'split'},{type:'services',label:'Our services',heading:'What we make',body:'Explore our tailoring services.',layout:'cards'},{type:'testimonials',label:'Testimonials',heading:'Kind words from our clients',body:'',layout:'cards'},{type:'contact',label:'Contact',heading:'Let us create something for you',body:'Get in touch with our team.',button:'Contact us',link:'/contact',layout:'centered'}]},
        {id:'essa',name:'Essa Jaya',url:'essajaya.com',kind:'Building materials',color:'blue',heading:'Building better, together.',description:'Quality building materials and dependable installation services.',status:'Published',sections:['Hero','About us','Products','Why choose us','FAQ','Contact'].map((label,i)=>({type:label.toLowerCase().replaceAll(' ','-'),label,heading:label,body:'Add your content here.',layout:'standard'}))},
        {id:'ello',name:'Ello Orthodontics',url:'elloorthodontics.com',kind:'Healthcare',color:'rose',heading:'A confident smile starts here.',description:'Personalised orthodontic care for every stage of your smile journey.',status:'Published',sections:['Hero','Our approach','Treatments','Meet the team','Contact'].map(label=>({type:label.toLowerCase().replaceAll(' ','-'),label,heading:label,body:'Add your content here.',layout:'standard'}))}
      ];
      const $ = id => document.getElementById(id);
      let sites = JSON.parse(localStorage.getItem('astroid-sites') || 'null') || starter;
      sites.forEach(s=>{s.sections=(s.sections||[]).map((x,i)=>typeof x==='string'?{type:x.toLowerCase().replaceAll(' ','-'),label:x,heading:x,body:'Add your content here.',layout:'standard'}:x)});
      let activeId=null, activeSectionIndex=null, selectedTemplate='business';
      const esc = s => String(s ?? '').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
      function persist(){localStorage.setItem('astroid-sites',JSON.stringify(sites));$('stat-sites').textContent=sites.length;$('stat-published').textContent=sites.filter(s=>s.status==='Published').length;$('stat-drafts').textContent=sites.filter(s=>s.status==='Draft').length;$('site-count').textContent=sites.length+' projects';}
      function card(s){return '<article class="site-card" data-open="'+s.id+'"><div class="site-cover '+s.color+'"><span class="cover-label">'+esc(s.name)+'</span><span class="cover-type">'+esc(s.kind)+'</span></div><div class="site-body"><h3 class="site-title">'+esc(s.name)+'</h3><div class="site-url">'+esc(s.url)+'</div><div class="site-meta"><span><i class="dot" style="background:'+(s.status==='Published'?'#77b96d':'#e4b65e')+'"></i>'+s.status+'</span><button data-open="'+s.id+'">Edit ↗</button></div></div></article>'}
      function renderSites(){$('site-grid').innerHTML=sites.map(card).join('');$('site-grid-all').innerHTML=sites.map(card).join('');persist()}
      function toast(msg){$('toast-root').innerHTML='<div class="toast">'+esc(msg)+'</div>';setTimeout(()=>$('toast-root').innerHTML='',2600)}
      function view(name){document.querySelectorAll('.content>section').forEach(x=>x.classList.add('hidden'));$(name+'-view').classList.remove('hidden');document.querySelectorAll('.nav').forEach(x=>x.classList.toggle('active',x.dataset.view===name));$('crumb').textContent=name==='editor'?'Editor':name[0].toUpperCase()+name.slice(1)}
      function currentSite(){return sites.find(x=>x.id===activeId)}
      function openEditor(id){activeId=id;const s=currentSite();if(!s)return;$('editor-title').textContent=s.name;$('edit-name').value=s.name;$('edit-heading').value=s.heading;$('edit-description').value=s.description;$('edit-url').value=s.url;renderSections();$('section-editor').classList.add('hidden');view('editor')}
      function renderSections(){const s=currentSite();$('sections-list').innerHTML=s.sections.map((x,i)=>'<div class="section-row"><div><strong>'+esc(x.label)+'</strong><small>'+esc(x.type)+' · '+String(i+1).padStart(2,'0')+' · '+esc(x.layout||'standard')+'</small></div><div style="display:flex;gap:6px"><button data-edit-section="'+i+'">Edit content</button><button data-remove="'+i+'">Remove</button></div></div>').join('')}
      function editSection(i){activeSectionIndex=i;const s=currentSite().sections[i];$('section-editor-title').textContent='Edit: '+s.label;$('section-label').value=s.label||'';$('section-eyebrow').value=s.eyebrow||'';$('section-heading').value=s.heading||'';$('section-body').value=s.body||'';$('section-image').value=s.image||'';$('section-button').value=s.button||'';$('section-link').value=s.link||'';$('section-layout').value=s.layout||'standard';$('section-editor').classList.remove('hidden');$('section-editor').scrollIntoView({behavior:'smooth',block:'nearest'})}
      function saveSection(){const s=currentSite().sections[activeSectionIndex];Object.assign(s,{label:$('section-label').value.trim()||'Untitled section',eyebrow:$('section-eyebrow').value,heading:$('section-heading').value,body:$('section-body').value,image:$('section-image').value,button:$('section-button').value,link:$('section-link').value,layout:$('section-layout').value});renderSections();$('section-editor').classList.add('hidden');toast('Section content saved')}
      function save(){const s=currentSite();if(!s)return;s.name=$('edit-name').value.trim()||s.name;s.heading=$('edit-heading').value;s.description=$('edit-description').value;s.url=$('edit-url').value;s.status='Draft';persist();renderSites();$('editor-title').textContent=s.name;toast('Draft saved in this browser')}
      function createModal(){ $('modal-root').innerHTML='<div class="modal-backdrop"><div class="modal"><h2>Create a website</h2><p>Start a new independent static website in this workspace.</p><div class="field"><label>Website name</label><input id="new-name" placeholder="e.g. My new business" /></div><div class="field"><label>Website domain (optional)</label><input id="new-domain" placeholder="example.com" /></div><div class="field"><label>Template</label><select id="new-template"><option value="business">Business Starter</option></select></div><div class="modal-actions"><button class="btn btn-light" id="cancel-modal">Cancel</button><button class="btn btn-dark" id="create-confirm">Create website →</button></div></div></div>'; $('cancel-modal').onclick=()=>$('modal-root').innerHTML='';$('create-confirm').onclick=()=>{const n=$('new-name').value.trim();if(!n){$('new-name').focus();return}const id='site-'+Date.now();sites.push({id,name:n,url:$('new-domain').value.trim()||'Not connected',kind:'New project',color:'',heading:'Welcome to '+n,description:'Tell visitors what makes your business different.',status:'Draft',sections:[{type:'hero',label:'Hero',heading:'Welcome to '+n,body:'Tell visitors what makes your business different.',layout:'split'},{type:'about',label:'About us',heading:'About '+n,body:'Introduce your business.',layout:'standard'},{type:'services',label:'Services',heading:'What we do',body:'Describe your services.',layout:'cards'},{type:'contact',label:'Contact',heading:'Get in touch',body:'Invite visitors to contact you.',layout:'centered'}]});persist();renderSites();$('modal-root').innerHTML='';toast('Website created');openEditor(id)}}
      function templateModal(){ $('modal-root').innerHTML='<div class="modal-backdrop"><div class="modal"><h2>Register a template</h2><p>Register a code-based template package in the workspace registry.</p><div class="field"><label>Template name</label><input id="reg-name" placeholder="e.g. Dental Practice" /></div><div class="field"><label>Template package path</label><input id="reg-path" placeholder="templates/dental" /></div><div class="field"><label>Version</label><input id="reg-version" value="1.0.0" /></div><div class="field"><label>Description</label><textarea id="reg-description" placeholder="What kind of websites is this for?"></textarea></div><div class="hint">This registers template metadata in this prototype. A source package validator and server-side registry will be connected in the backend stage.</div><div class="modal-actions"><button class="btn btn-light" id="cancel-modal">Cancel</button><button class="btn btn-dark" id="register-confirm">Register template</button></div></div></div>'; $('cancel-modal').onclick=()=>$('modal-root').innerHTML='';$('register-confirm').onclick=()=>{const name=$('reg-name').value.trim();if(!name){$('reg-name').focus();return}const t={id:'custom-'+Date.now(),name,path:$('reg-path').value,version:$('reg-version').value,description:$('reg-description').value};const list=JSON.parse(localStorage.getItem('astroid-templates')||'[]');list.push(t);localStorage.setItem('astroid-templates',JSON.stringify(list));$('modal-root').innerHTML='';renderTemplates();toast('Template registered in this browser')}}
      function renderTemplates(){const custom=JSON.parse(localStorage.getItem('astroid-templates')||'[]');const grid=$('template-grid');grid.querySelectorAll('[data-custom-template]').forEach(x=>x.remove());custom.forEach(t=>{const el=document.createElement('article');el.className='site-card';el.dataset.customTemplate=t.id;el.innerHTML='<div class="site-cover blue"><span class="cover-label">'+esc(t.name)+'</span><span class="cover-type">CUSTOM TEMPLATE</span></div><div class="site-body"><h3 class="site-title">'+esc(t.name)+'</h3><div class="site-url">'+esc(t.description)+'</div><div class="site-meta">v'+esc(t.version)+' · '+esc(t.path)+'</div></div>';grid.insertBefore(el,$('register-template'))})}
      document.addEventListener('click',e=>{const nav=e.target.closest('[data-view]');if(nav)view(nav.dataset.view);const op=e.target.closest('[data-open]');if(op)openEditor(op.dataset.open);const edit=e.target.closest('[data-edit-section]');if(edit)editSection(Number(edit.dataset.editSection));const rm=e.target.closest('[data-remove]');if(rm){currentSite().sections.splice(Number(rm.dataset.remove),1);renderSections();$('section-editor').classList.add('hidden')}const tpl=e.target.closest('[data-template]');if(tpl){selectedTemplate=tpl.dataset.template;$('template-detail-title').textContent='Business Starter · v1.0.0';$('template-detail-copy').textContent='A flexible business template with hero, about, services, benefits, testimonials, FAQ, CTA and contact sections. Select it when creating a website.';$('template-detail').classList.remove('hidden')}const use=e.target.closest('[data-template-use]');if(use){createModal()}});
      ['new-site','new-site-2','quick-create'].forEach(id=>$(id).onclick=createModal);
      $('quick-edit').onclick=()=>openEditor(sites[0].id);$('quick-template').onclick=()=>{view('templates');renderTemplates()};$('quick-publish').onclick=()=>{openEditor(sites.find(s=>s.status==='Draft')?.id||sites[0].id);toast('Review your draft before publishing')};
      $('save-btn').onclick=save;$('add-section').onclick=()=>{const name=prompt('What section would you like to add? (Hero, About, Services, Features, Gallery, Testimonials, FAQ, CTA, Contact)');if(name&&name.trim()){const label=name.trim();const type=label.toLowerCase().replaceAll(' ','-');currentSite().sections.push({type,label,eyebrow:'',heading:label,body:'Write your section content here.',image:'',button:'',link:'',layout:'standard'});renderSections();editSection(currentSite().sections.length-1)}};
      $('save-section').onclick=saveSection;$('close-section-editor').onclick=()=>$('section-editor').classList.add('hidden');
      $('register-template').onclick=templateModal;$('template-detail-use').onclick=createModal;
      $('publish-btn').onclick=()=>{save();toast('Publishing requires the GitHub integration backend')};
      $('preview-btn').onclick=()=>{saveSectionIfOpen();const s=currentSite();const w=window.open('','_blank');if(!w){toast('Allow pop-ups to open preview');return}const body=s.sections.map(x=>'<section style="padding:35px 0;border-top:1px solid #eee"><small>'+esc(x.eyebrow||'')+'</small><h2>'+esc(x.heading||x.label)+'</h2><p>'+esc(x.body||'')+'</p>'+(x.image?'<img src="'+esc(x.image)+'" style="max-width:100%;max-height:360px;border-radius:12px">':'')+(x.button?'<a href="'+esc(x.link||'#')+'" style="display:inline-block;padding:12px 18px;background:#20372c;color:white;text-decoration:none;border-radius:8px">'+esc(x.button)+'</a>':'')+'</section>').join('');w.document.write('<!doctype html><html><head><title>'+esc(s.name)+'</title><style>body{font:17px Arial;margin:0;color:#26362b}header{padding:28px 8%;border-bottom:1px solid #eee}main{padding:8vh 10%;max-width:900px;margin:auto}h1{font-size:52px;line-height:1.1}p{line-height:1.7;color:#68756c}</style></head><body><header><b>'+esc(s.name)+'</b></header><main><small>WELCOME</small><h1>'+esc(s.heading)+'</h1><p>'+esc(s.description)+'</p>'+body+'</main></body></html>');w.document.close()};
      function saveSectionIfOpen(){if(!$('section-editor').classList.contains('hidden'))saveSection()}
      $('github-connect').onclick=()=>toast('GitHub OAuth setup is the next backend integration');
      renderSites();renderTemplates();
    </script> </body>
</html>