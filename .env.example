# Dashboard server-side proxy (never expose this key in browser JavaScript)
ASTROID_API_URL=http://localhost:8787
ASTROID_API_KEY=replace-with-a-long-random-secret

# API server
API_PORT=8787

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/astroid
DATABASE_SSL=false

# GitHub publishing: token needs repository creation, Contents write and Workflows write permissions
ASTROID_GITHUB_TOKEN=
