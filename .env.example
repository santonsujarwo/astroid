# API server
API_PORT=8787
ASTROID_API_KEY=replace-with-a-long-random-secret

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/astroid
DATABASE_SSL=false

# GitHub publishing (fine-grained PAT with repository create and contents write permissions)
ASTROID_GITHUB_TOKEN=
# Optional: defaults to the authenticated GitHub account
ASTROID_GITHUB_OWNER=
